---
import { EMAIL, LINKEDIN } from '../lib/url';
---

<footer class="footer">
  <div class="container footer__inner">
    <h2 class="t-display-l" data-reveal>Let’s work together</h2>
    <div class="footer__contact" data-reveal>
      <a class="footer__email link-plain" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a class="footer__linkedin" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
        LinkedIn <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
    <div class="footer__bottom t-body-s">
      <p>Based in Passau, Germany · Authorized to work in Germany</p>
      <p>© 2026 Kseniia Mukhutdinova</p>
    </div>
  </div>
</footer>
